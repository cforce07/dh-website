---
/**
 * FinalCta — block 12. The page's last impression and its designated
 * conversion surface, so it gets more vertical room than a standard
 * section (--space-section-lg, tokens.css) and both CTAs at full size
 * rather than the compact treatment used inline elsewhere on the page.
 *
 * Headline and supporting copy are verbatim per the task brief — neither
 * is assembled from data. URLs are never hardcoded: the primary button
 * reads `company.requirementFormUrl` and the secondary reads
 * `defaultWhatsappUrl()`, the same sources Hero (block 01) uses, so a
 * destination change only ever happens in one place.
 *
 * Block 07 (TwoSidedMatch) is the only section that shifts to
 * --color-deep, and a second dark band here would break that "one
 * register change" reading. Weight comes instead from space, a larger
 * display size on the headline, and a small decorative rule (.cta-mark)
 * in --color-brand-teal.
 *
 * That rule used to be described as "reusing the brand-teal graphic
 * treatment established in Hero". Hero's teal was the 2px seam dividing
 * the split diptych, and that whole visual was deleted on 2026-08-16 —
 * Hero now carries no brand teal at all. The treatment this echoes is
 * Process's rail (block 05), which is the page's other use of the raw
 * logo teal as a graphic line. Teal is decorative-only here, as tokens.css
 * requires: --color-brand-teal never carries text and never fills a
 * button.
 *
 * The ground is --color-surface (cream), not --color-surface-raised: it
 * is the last step of the page's alternating sequence and block 11 (FAQ)
 * immediately above it is white. Changed 2026-08-16 with the rest of the
 * sequence; the two must be judged together, so do not flip this one
 * back on its own.
 *
 * `heading` and `lede` are optional so other pages can close with this
 * same conversion surface under their own framing. The CTA pair — order,
 * labels, and both hrefs — is not parameterised: every caller gets the
 * same primary/secondary buttons pointed at the same single-sourced URLs.
 */
import Container from '../components/Container.astro'
import Button from '../components/Button.astro'
import { company } from '../data/company'
import { defaultWhatsappUrl } from '../lib/whatsapp'

interface Props {
  heading?: string
  lede?: string
}

const {
  heading = 'Tell us what your family needs.',
  lede = 'Take the first step toward finding a helper who fits your family’s needs.',
} = Astro.props

const whatsappHref = defaultWhatsappUrl()
---

<section class="final-cta">
  <Container width="narrow">
    <span class="cta-mark" aria-hidden="true"></span>
    <h2 class="cta-headline">{heading}</h2>
    <p class="cta-copy">{lede}</p>

    <div class="cta-actions">
      <Button variant="primary" href={company.requirementFormUrl}>Submit Your Requirements</Button>
      <Button variant="secondary" href={whatsappHref} external>WhatsApp Us</Button>
    </div>
  </Container>
</section>

<style>
  .final-cta {
    padding-block: var(--space-section-lg);
    background: var(--color-surface);
    text-align: center;
  }

  .cta-mark {
    display: inline-block;
    width: var(--space-8);
    height: 2px;
    margin-bottom: var(--space-6);
    border-radius: var(--radius-sm);
    background: var(--color-brand-teal);
  }

  .cta-headline {
    margin: 0 auto;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--size-h1);
    font-weight: var(--font-weight-medium);
    line-height: 1.1;
    color: var(--color-ink);
  }

  .cta-copy {
    max-width: 42ch;
    margin: var(--space-6) auto 0;
    font-family: var(--font-text);
    font-size: var(--size-lede);
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
</style>
