---
/**
 * Reviews — block 10b. Conditional on the `reviews` content collection,
 * which DirectHired has not yet supplied real Google review data for.
 * Master brief §78 forbids inventing testimonials, so the collection
 * starts empty (src/content/reviews/.gitkeep is the only file in it) and
 * stays empty until verified reviews land.
 *
 * Same guard as MeetHelpers, and for the same reason it is NOT a <Tbd>:
 * the whole <section> is wrapped in `reviews.length > 0 &&` so an empty
 * collection renders nothing — no shell, no placeholder quote, no star
 * rating drawn from thin air. See tests/conditional-blocks.test.ts.
 *
 * `rating` and `author` are structured frontmatter; the review text
 * itself is the markdown body, rendered the same way FAQ answers are
 * (entry.render() → <Content />) rather than duplicated into a schema
 * field, since it is genuinely prose, not a short label.
 *
 * Unboxed, as of 2026-08-16. A boxed Google review is a widget; an
 * unboxed one is a testimonial — the quote is set in --font-display at
 * reading size, separated from its neighbours by a hairline and nothing
 * else. Practically it also takes this block off Card, which is what
 * lets block 10b sit on cream between two white neighbours instead of
 * being forced onto the same ground as blocks 08-11 (see the ground
 * sequence note in HelperSources.astro). This was rebuilt while the
 * collection is still empty, so it carries zero regression surface: the
 * `reviews.length > 0 &&` guard and the renders-absolutely-nothing
 * behaviour are unchanged and still covered by
 * tests/conditional-blocks.test.ts.
 */
import { getCollection } from 'astro:content'
import Container from '../components/Container.astro'
import SectionHeader from '../components/SectionHeader.astro'

const reviews = (await getCollection('reviews')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
)

const rendered = await Promise.all(
  reviews.map(async (review) => ({
    review,
    Content: (await review.render()).Content,
  })),
)
---

{
  reviews.length > 0 && (
    <section class="reviews">
      <Container>
        <SectionHeader title="What families are saying" lede="Reviews from families who found their helper through DirectHired." />

        <div class="quote-wall">
          {rendered.map(({ review, Content }) => (
            <figure class="quote">
              <span class="review-stars" aria-label={`${review.data.rating} out of 5 stars`}>
                {'★'.repeat(review.data.rating)}
                {'☆'.repeat(5 - review.data.rating)}
              </span>

              <blockquote class="review-body rich-text">
                <Content />
              </blockquote>

              <figcaption class="review-meta">{review.data.author} · Google review</figcaption>
            </figure>
          ))}
        </div>
      </Container>
    </section>
  )
}

<style>
  .reviews {
    padding-block: var(--space-section);
    /* Cream, between white neighbours (10a Meet Helpers above, 11 FAQ
       below). This block no longer renders Card, so the white-card-on-
       white-ground collision that forced --color-surface here in the
       first place no longer applies — but cream is still the right
       choice, for rhythm rather than for contrast. */
    background: var(--color-surface);
  }

  .quote-wall {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-12);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .review-stars {
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .review-body {
    /* The quote itself, in the display face at reading size — the thing
       that separates a testimonial from a review widget. Measure capped
       so a long review does not run the full column width. */
    max-width: 34ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--size-lede);
    font-weight: var(--font-weight-regular);
    line-height: 1.4;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  /*
   * The quote is markdown, so its block rhythm and link treatment come from
   * `.rich-text` in src/styles/global.css, which the <blockquote> carries.
   *
   * WHAT USED TO BE HERE, 2026-08-16: `p:first-child { margin-top: 0 }` and
   * `p:last-child { margin-bottom: 0 }` — two rules zeroing margins that
   * global.css's `* { margin: 0 }` had already zeroed, and nothing at all
   * restoring space BETWEEN paragraphs. A two-paragraph review would have
   * rendered as one unbroken block. It never shipped only because
   * src/content/reviews/ is deliberately empty, which is the worst way for a
   * defect to wait: it would have arrived as a rendering fault in content
   * nobody changed, on the day DirectHired supplies reviews, with no diff to
   * connect it to.
   *
   * `.review-body` keeps `margin: 0` above, which the shared class does not
   * contradict: `.rich-text > * + *` sets a margin on the quote's CHILDREN,
   * never on the quote itself.
   */

  .review-meta {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--size-small);
    color: var(--color-ink-muted);
  }

  /* 48em is --bp-tablet (tokens.css). Two quotes abreast is as wide as
     this should go — three columns of pull quote start reading as a
     card grid again, which is the thing this block came out of. An
     explicit count, not auto-fit: an odd number of reviews must leave
     the last quote in a half row, not an empty cell in a full one. */
  @media (min-width: 48em) {
    .quote-wall {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-12);
    }
  }
</style>
