---
/**
 * TwoSidedMatch — block 07, the emotional peak (design spec §6.3) and the
 * only block that shifts palette register to `--color-deep`.
 *
 * The composition is derived from the logo itself rather than an invented
 * metaphor (see docs/design/palette-proposal.md and src/assets/logo-mark.svg):
 * the "H" in DirectHired is two human figures — round heads, vertical
 * bodies — joined by a crossbar where their arms meet. That is "Happy
 * Employer. Happy Helper." already encoded in the mark. From --bp-wide up
 * the block redraws that H at page scale:
 *
 *   - the two `.side` columns carry the uprights, as a 2px rule on the
 *     OUTER edge of each column (left rule on the left column, right rule
 *     on the right), exactly as the H's two strokes are its outer ones.
 *     They used to sit on the inner edges, both against the central
 *     gutter, which draws `] [` rather than an H;
 *   - each `.side-mark` is a head and sits centred ON its own upright, at
 *     the top, the way the mark's two circles cap its two bodies. It used
 *     to float at the top-left of the text column ~400px from any rule,
 *     reading as a decorative bullet that connected to nothing;
 *   - `.match-composition::before` is the crossbar. It is absolutely
 *     positioned across the whole composition, `left: 0` to `right: 0`,
 *     so it terminates exactly on the outer edge of each upright and
 *     visibly MEETS them. Previously it was `.bridge::before`, which
 *     spanned only the 32px middle grid column and had a 32px grid gap on
 *     each side, so it reached neither upright and rendered as a short
 *     dash floating in clear space.
 *
 * The crossbar's height is not 50%: it lands in `--head-clear`, the band
 * between the head marks and the `.side-title`s, which is content-free in
 * both columns by construction (`.side-mark`'s margin-bottom and the
 * crossbar's `top` are derived from the same two custom properties). That
 * is both where the mark puts it — the arms meet high on the body, not
 * halfway down it — and the only horizontal line through this layout that
 * cannot strike through text however the titles wrap.
 *
 * The crossbar is the page's ONE connective gesture. Everything else on
 * this page that draws a line is a divider (section rules, `.pillar`
 * borders, the FAQ hairlines); this is the single line whose whole job is
 * to touch two things. If a future change makes it stop touching, the
 * block has lost its reason to exist.
 *
 * Per brief §22 / §83, this is shown as composition, not prose: the
 * Employer and Helper lists sit side by side with no explanatory
 * paragraph between them, and the resolving line lands only once both
 * sides have been seen. "Happy Employer. Happy Helper." itself appears
 * once, here — the brief's own instruction against turning it into a
 * slogan repeated on every block. It is the section's `<h2>` (heading the
 * composition, so it correctly precedes the `<h3>` Employer/Helper
 * sub-headings); the resolving line is a visually large `<p>`, not a
 * second heading, so the page's heading outline stays in sequence.
 */
import Container from '../components/Container.astro'

const employerSide = ['Family needs', 'Lifestyle', 'Household responsibilities', 'Skills required', 'Expectations']

const helperSide = ['Skills', 'Experience', 'Expectations', 'Suitable responsibilities', 'Working environment']
---

<section class="two-sided">
  <Container>
    <h2 class="match-kicker">Happy Employer. Happy Helper.</h2>

    <div class="match-composition">
      <div class="side">
        <span class="side-mark" aria-hidden="true"></span>
        <h3 class="side-title">Employer</h3>
        <ul class="side-list">
          {employerSide.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="side">
        <span class="side-mark" aria-hidden="true"></span>
        <h3 class="side-title">Helper</h3>
        <ul class="side-list">
          {helperSide.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>

    <p class="match-resolve">Better matching happens when both sides are understood.</p>
  </Container>
</section>

<style>
  .two-sided {
    padding-block: var(--space-section);
    background: var(--color-deep);
    color: var(--color-on-deep);
  }

  .match-kicker {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--size-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent-on-deep);
  }

  .match-composition {
    /*
     * --head-size / --head-clear are the two numbers the whole figure is
     * built from, declared once here so the head marks and the crossbar
     * cannot drift apart. --head-clear is the vertical band between the
     * heads and the titles; the crossbar lands in the middle of it, which
     * is why that band has to be wider than the flex gap that would
     * otherwise separate the two.
     */
    --head-size: 1rem;
    --head-clear: var(--space-6);

    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-12);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 2px solid var(--color-accent-on-deep);
  }

  .side-mark {
    display: inline-block;
    width: var(--head-size);
    height: var(--head-size);
    /* Opens --head-clear between the head and the title on top of the
       flex gap already between them. Paired with the crossbar's `top`. */
    margin-bottom: calc(var(--head-clear) - var(--space-4));
    border-radius: 50%;
    background: var(--color-accent-on-deep);
  }

  .side-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-on-deep);
  }

  .side-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-text);
    color: var(--color-on-deep);
  }

  .match-resolve {
    max-width: 42rem;
    margin-top: var(--space-16);
    font-family: var(--font-display);
    font-size: var(--size-h2);
    font-weight: var(--font-weight-medium);
    color: var(--color-on-deep);
  }

  /* 64em is --bp-wide (tokens.css) — a content-layout switch, not a nav
     breakpoint. This is where the two sides can sit side by side with
     enough width between them for the H to read; the file header above
     describes what gets drawn from here up. */
  @media (min-width: 64em) {
    .match-composition {
      /* max-content, not 1fr: each side is exactly as wide as its own
         list, and `space-between` then pushes one to each edge of the
         composition. Two 1fr tracks made columns ~670px wide holding
         ~230px of text, so the right-hand upright stood 400px clear of
         the words it belonged to and read as an unrelated page rule.
         Sized to content, each upright sits against its own side and the
         empty space falls in the middle — which is the span the crossbar
         crosses. --space-24 is the floor on that gap, not its usual
         value. */
      grid-template-columns: max-content max-content;
      justify-content: space-between;
      column-gap: var(--space-24);
      /* Capped at the same 48rem reading measure Container calls
         `narrow`, and left-aligned on the page's axis with the kicker
         and the resolving line. Left to fill the full 72rem container
         the two uprights stand 1,088px apart around a 260px-tall figure,
         and a rule that runs the whole column width stops reading as a
         drawn mark and starts reading as a section border. Bounded, it
         reads as one object on the page. */
      max-width: 48rem;
      /* stretch (the grid default), stated because it is load-bearing:
         the uprights ARE the two columns' borders, so an `start` here
         would let one column's list wrap to a different height and draw
         an H with legs of different lengths. */
      align-items: stretch;
      /* Containing block for the crossbar. */
      position: relative;
    }

    .side {
      border-top: none;
      padding-top: 0;
    }

    /* The uprights: outer edge of each column, so the pair brackets the
       whole composition the way the mark's two strokes bracket the H. */
    .side:first-child {
      border-left: 2px solid var(--color-accent-on-deep);
      padding-left: var(--space-8);
    }

    .side:last-child {
      border-right: 2px solid var(--color-accent-on-deep);
      padding-right: var(--space-8);
    }

    /*
     * Each head sits centred ON its own upright. The offset is
     * (padding + half the border) out to the rule, then half the head
     * back, i.e. --space-8 + 1px + --head-size/2 = 32 + 1 + 8 = 41px.
     * A flex column puts every item on its own line, so this moves the
     * mark alone and leaves the title and list on the text axis.
     */
    .side:first-child .side-mark {
      margin-left: calc((var(--space-8) + 1px + var(--head-size) / 2) * -1);
    }

    .side:last-child .side-mark {
      align-self: flex-end;
      margin-right: calc((var(--space-8) + 1px + var(--head-size) / 2) * -1);
    }

    /*
     * The crossbar. left/right: 0 is the composition's content box, whose
     * edges ARE the outer edges of the two uprights (a grid item's border
     * starts at its column edge), so the bar terminates on both rules
     * with no gap — it is a connector, not a floating dash. Absolutely
     * positioned, so it is not a grid item and does not take a column.
     */
    .match-composition::before {
      content: '';
      position: absolute;
      top: calc(var(--head-size) + var(--head-clear) / 2 - 1px);
      left: 0;
      right: 0;
      height: 2px;
      background: var(--color-accent-on-deep);
    }
  }
</style>
