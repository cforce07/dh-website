---
/**
 * HelperSources — block 08. Maps over the `helpers` content collection, so
 * a fourth source (Philippines is plausible later) appears in the row the
 * moment its markdown file lands — no markup change, no data change here.
 * The ONE thing a fourth source still needs is a column count: the grid
 * below is an explicit `repeat(3, 1fr)`, not `auto-fit`, and 2x2 vs 4-up
 * is a design decision rather than something to discover at a viewport
 * width. See the comment on that media query for the reasoning.
 *
 * Astro's legacy `type: 'content'` collections reserve the `slug`
 * frontmatter key and strip it from `data` before Zod validation (see the
 * comment at src/content/config.ts:35-42) — every href below reads
 * `helper.slug`, never `helper.data.slug`, or the link silently becomes
 * `/helpers/undefined`.
 *
 * The content files already avoid characterising any nationality; this
 * component renders their copy as written and adds no framing of its own.
 *
 * NOT a card grid, and no longer one as of 2026-08-16. Two reasons, and
 * both matter:
 *
 *   1. Card is --color-surface-raised, so any section hosting one is
 *      forced onto cream to keep the cards visible. Five card-hosting
 *      sections in a row is what flattened blocks 08-11 into a single
 *      ~2,400px cream field. Unboxing this block is what lets the page's
 *      ground alternation resume. The divided-row pattern is lifted from
 *      Difference.astro (block 04), which chose it for the same reason.
 *   2. There is nothing here that needs a container to be legible. Each
 *      source is a name and a link; a box around a name is a widget.
 *
 * There is deliberately no per-source blurb, and there will not be one.
 * The `summary` field held the same sentence three times with the source
 * name swapped; it was deleted alongside `flag` (see src/content/config.ts
 * for both) and DirectHired answered the open question on 2026-08-16:
 * there is no real difference between the sources. Same service, same
 * package, same matching process — only the source differs.
 *
 * That answer is why `.source-equivalence` below exists. Deleting the
 * three summaries left three bare names and nothing explaining why they
 * carry no description, which reads as content that failed to load rather
 * than as a decision. The honest resolution is to say the true thing ONCE,
 * above the row, and let the names be names.
 *
 * Do not turn that one statement back into three. A sentence per source
 * can only be written by asserting a fact about that place, nothing in
 * this repository knows one, and inventing one is a master brief §78
 * violation as well as a §42 one. tests/content.test.ts asserts both the
 * absence of the summaries and the presence of this statement.
 *
 * VOCABULARY: the three sources are Indonesia, Myanmar and MIZORAM, and
 * Mizoram is a state of India, not a country. Nothing rendered by this
 * component — lede, equivalence line, class names — may say "country" or
 * "countries" of the set as a whole. Say "source", or "where a helper
 * comes from". Master brief §412 also forbids labelling Mizoram "India",
 * so the honest vocabulary is the source-neutral one, in both directions.
 * tests/content.test.ts asserts this across the rendered copy.
 */
import { getCollection } from 'astro:content'
import Container from '../components/Container.astro'
import SectionHeader from '../components/SectionHeader.astro'

const helperSources = (await getCollection('helpers')).sort((a, b) => a.data.order - b.data.order)
---

<section class="helper-sources">
  <Container>
    <SectionHeader
      title="Helpers from trusted sources"
      lede="We work with helpers from a number of sources, each matched to your family based on the requirements you share with us."
    />

    <p class="source-equivalence">
      Wherever a helper comes from, the service is the same — the same fly-in package,
      the same matching process. The source is the only difference.
    </p>

    {/* The source name IS the link, rather than a name followed by a
        separate "Learn more". Three links reading "Learn more" give a
        screen reader three identical accessible names pointing at three
        different pages, and Lighthouse's `link-text` SEO audit fails
        them outright — measured on this page, it took the SEO category
        from 1.00 to 0.92. That audit reads the visible text only, so an
        aria-label does not rescue it. */}
    <div class="source-row">
      {
        helperSources.map((helper) => (
          <div class="source">
            <h3 class="source-name">
              <a class="source-link" href={`/helpers/${helper.slug}`}>{helper.data.source}</a>
            </h3>
          </div>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .helper-sources {
    padding-block: var(--space-section);
    /* White, and it can be white because this block no longer hosts a
       Card. Blocks 08-11 were one unbroken cream field until this one
       came out of boxes; see the file header. */
    background: var(--color-surface-raised);
  }

  /* Sits between the lede and the row, and is spaced to belong to the row
     rather than to read as a second lede: --space-12 above it (the gap the
     row used to take from the header) and only --space-6 below, so it
     reads as the line that governs the three names under it.

     Set at --size-body rather than --size-lede so it does not compete with
     the SectionHeader lede above it, and given the same 60ch measure and
     `balance` as PricingSection's qualifier, which does the same job in the
     same register one block earlier. */
  .source-equivalence {
    max-width: 60ch;
    text-wrap: balance;
    margin-top: var(--space-12);
    margin-bottom: 0;
    font-family: var(--font-text);
    font-size: var(--size-body);
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  .source-row {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-6);
  }

  .source {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .source-name {
    margin: 0;
    font-family: var(--font-display);
    /* Larger than a card title was. With no blurb under it the name IS
       the content of the row, so it is set to carry that weight. */
    font-size: var(--size-h3);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
  }

  /* A permanent underline, not a hover-only one: with the name as the
     only content of the row, nothing else signals that it is clickable,
     and a hover cue is no cue at all on a touch screen. Kept thin and
     hairline-coloured so it reads as an affordance rather than as the
     third rule in a row that already has two. */
  .source-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--color-border);
    text-underline-offset: 6px;
    transition: color var(--duration-fast) var(--ease);
  }

  .source-link:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  /* 48em is --bp-tablet (tokens.css). Same divided-row step-up as
     Difference.astro's pillars: the rule moves from above each item to
     between them.

     An explicit count, not `repeat(auto-fit, minmax(...))`. auto-fit
     picks its column count from available width and leaves orphan cells
     whenever the content count is not a multiple of it — the defect
     Services (block 09) had, where six cards rendered 4 + 2 with two
     visibly empty cells at >=1280px. Three sources is three columns. A
     fourth source is a design decision (2x2 vs 4-up), not something to
     be discovered at a viewport width, so it lands here by hand. */
  @media (min-width: 48em) {
    .source-row {
      grid-template-columns: repeat(3, 1fr);
    }

    .source {
      padding-top: 0;
      padding-left: var(--space-6);
      border-top: none;
      border-left: 1px solid var(--color-border);
    }

    .source:first-child {
      padding-left: 0;
      border-left: none;
    }
  }
</style>
