---
/**
 * Faq — block 11. Filters the `faq` collection (already populated by an
 * earlier task, see src/content/faq) to entries whose `surfaces` array
 * contains 'home', sorts by `order`, and takes the first six.
 *
 * Rendered as native <details>/<summary> — not a hand-rolled accordion.
 * Native disclosure needs zero JavaScript, is keyboard-operable (Enter /
 * Space toggle a <summary> for free), and is announced correctly by
 * screen readers without any ARIA bookkeeping on our part. The default
 * disclosure triangle is removed and replaced with a custom plus/minus
 * indicator that flips purely off the `[open]` attribute selector — no
 * script is involved in that either.
 */
import { getCollection } from 'astro:content'
import Container from '../components/Container.astro'
import SectionHeader from '../components/SectionHeader.astro'

const homeFaqs = (await getCollection('faq'))
  .filter((entry) => entry.data.surfaces.includes('home'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6)

const rendered = await Promise.all(
  homeFaqs.map(async (entry) => ({
    entry,
    Content: (await entry.render()).Content,
  })),
)
---

<section class="faq">
  <Container width="narrow">
    <SectionHeader
      title="Questions families ask us"
      lede="A few of the things we're asked most often. See the full list for everything else."
    />

    <div class="faq-list">
      {
        rendered.map(({ entry, Content }) => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{entry.data.question}</span>
              <span class="faq-icon" aria-hidden="true" />
            </summary>
            <div class="faq-answer">
              <Content />
            </div>
          </details>
        ))
      }
    </div>

    <p class="faq-more">
      <a class="faq-link" href="/faq">See all FAQs</a>
    </p>
  </Container>
</section>

<style>
  .faq {
    padding-block: var(--space-section);
  }

  .faq-list {
    margin-top: var(--space-12);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
  }

  /* Remove the native disclosure marker so the custom indicator is the only one. */
  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::marker {
    content: '';
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--color-accent);
    transform: translate(-50%, -50%);
    transition: transform var(--duration-base) var(--ease);
  }

  .faq-icon::before {
    width: 12px;
    height: 2px;
  }

  .faq-icon::after {
    width: 2px;
    height: 12px;
  }

  .faq-item[open] .faq-icon::after {
    transform: translate(-50%, -50%) scaleY(0);
  }

  .faq-answer {
    max-width: 60ch;
    padding-bottom: var(--space-6);
    font-family: var(--font-text);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .faq-answer :global(p:first-child) {
    margin-top: 0;
  }

  .faq-answer :global(p:last-child) {
    margin-bottom: 0;
  }

  .faq-more {
    margin-top: var(--space-8);
  }

  .faq-link {
    font-family: var(--font-text);
    font-size: var(--size-body);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }

  .faq-link:hover {
    color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }
</style>
