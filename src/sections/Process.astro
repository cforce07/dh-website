---
/**
 * Process — block 05. Five steps of a personalised human consultation,
 * never framed as automated or AI-driven. Rendered as an <ol> (the steps
 * are genuinely sequential, so screen reader users get that order for
 * free) with a connecting rule drawn by this section around ProcessStep's
 * typographic index markers — vertical rail on narrow viewports,
 * horizontal rule above the row from --bp-desktop up.
 *
 * Two wording constraints: brief §23 notes the process may still be
 * refined, so the lede says "typically" rather than asserting that EVERY
 * placement runs this way; and §78 forbids inventing staff details, so
 * step 4 says "our team", not "your consultant" — DirectHired has not
 * confirmed that one named person carries a placement end to end.
 */
import Container from '../components/Container.astro'
import SectionHeader from '../components/SectionHeader.astro'
import ProcessStep from '../components/ProcessStep.astro'

const steps = [
  // Steps 1 and 2 of the brief's five ("Understand your family" /
  // "Understand your needs") were merged into one on DirectHired's
  // instruction, 2026-08-16. They described the same conversation, and
  // brief §23 anticipates the process being refined.
  {
    label: 'Understand your household needs',
    description: 'We start with a conversation about your household, your routines, and the specific tasks, schedule and expectations a helper would take on.',
  },
  {
    label: 'Recommend suitable helpers',
    description: 'Based on that conversation, we recommend a small number of helpers whose experience fits what you described.',
  },
  {
    label: 'Interview & decide',
    description: 'You interview each candidate directly and decide who joins your household, with our team on hand to answer questions.',
  },
  {
    label: 'Support the placement',
    description: 'We stay involved after the placement starts, so early questions or adjustments do not fall through the cracks.',
  },
]

// Spelled out rather than a numeral, and derived rather than typed: the lede
// used to say "five steps" as a literal, which is precisely what went stale
// when two steps merged.
const NUMBER_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight'] as const
const stepCount = NUMBER_WORDS[steps.length] ?? String(steps.length)
---

<section class="process">
  <Container>
    <SectionHeader
      title="A better match starts with understanding."
      lede={`A placement typically follows ${stepCount} steps, built around your family rather than a shortlist.`}
    />

    <ol class="process-rail">
      {
        steps.map((step, i) => (
          <li>
            <ProcessStep index={i + 1} label={step.label} description={step.description} />
          </li>
        ))
      }
    </ol>
  </Container>
</section>

<style>
  .process {
    padding-block: var(--space-section);
    /*
     * The one section on the page grounded in --color-surface-teal
     * (tokens.css): --color-brand-teal washed to 8% over --color-surface.
     * It is here rather than anywhere else because Process is already the
     * only block using brand teal as a graphic (the rail below), it hosts
     * no Card, and a ground change between 05 and 06 breaks up what was
     * otherwise a long unbroken cream run. Measured on this wash:
     * ink 12.87:1, ink-muted 7.32:1, accent 5.54:1 — all clear AA, and
     * asserted in tests/tokens.test.ts. One section only: a second teal
     * ground turns a register into wallpaper.
     */
    background: var(--color-surface-teal);
  }

  .process-rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin-top: var(--space-12);
    padding-left: var(--space-6);
    border-left: 1.5px solid var(--color-brand-teal);
  }

  /*
   * 80em (1280px), NOT --bp-wide's 64em. Five steps sharing a 1024px
   * viewport gives each one ~180px of measure: every label wraps after
   * two words and every description runs 5-7 lines of 3-5 words, which
   * is not a rail, it is five narrow gutters. At 1280px each step gets
   * ~215px and the rail reads as intended. 80em has no token — see
   * tokens.css's breakpoint block, which documents --bp-tablet,
   * --bp-wide and --bp-desktop only; that file belongs to another
   * workstream, so this literal is recorded here instead. If a second
   * file ever needs 80em, name it there first.
   */
  @media (min-width: 80em) {
    .process-rail {
      flex-direction: row;
      gap: var(--space-6);
      padding-left: 0;
      padding-top: var(--space-6);
      border-left: none;
      border-top: 1.5px solid var(--color-brand-teal);
    }

    .process-rail > li {
      flex: 1;
    }
  }
</style>
