---
/**
 * BaseLayout — the frame every page sits inside: skip link, Header, the
 * `#main` landmark (pages own their own single <h1> inside it), Footer,
 * and the mobile CTA bar.
 *
 * Owns the display-face preload (design spec §3.2): Fraunces is declared
 * in tokens.css with font-display: swap, but a `swap` fallback still
 * flashes on first paint unless the font file is preloaded — and no
 * <head> existed anywhere before this layout. Preloading it here keeps
 * the LCP budget (< 2.5s) intact.
 */
import '../styles/tokens.css'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import MobileCtaBar from '../components/MobileCtaBar.astro'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />
    {/*
      public/favicon.svg is DirectHired's mark — the H from the wordmark,
      the same asset as src/assets/logo-mark.svg. It replaced the
      unmodified Astro starter favicon, which meant the browser tab of a
      licensed Singapore employment agency displayed a JavaScript
      framework's logo.

      There is deliberately NO <link rel="icon" href="/favicon.ico">, and
      no favicon.ico in public/. The one that shipped was also Astro's,
      and a stale framework .ico sitting behind DirectHired's SVG is
      worse than no .ico at all: every browser that reads .ico at all
      prefers it in some surface (Windows shortcuts, bookmark bars,
      legacy tabs), so the wrong mark would keep surfacing. Rasterising a
      correct multi-size .ico needs an image toolchain this repo does not
      have and will not add for a 2.5s LCP budget. SVG favicons are
      supported by every browser this site targets. When DirectHired's
      brand assets are next revisited, generate a 16/32/48 .ico from
      logo-mark.svg (teal H on #FAF8F5, so it survives both light and
      dark tab bars) and restore the <link> — do not restore the <link>
      without the file, and do not restore a file that is not the H.
    */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/*
      --color-surface (#FAF8F5), not --color-deep. Android Chrome paints
      the URL bar with this, and the sticky header directly beneath it is
      --color-surface — so the chrome reads as continuous with the page
      instead of stacking a dark band on top of a cream header. Kept as a
      literal because <meta> content cannot read a CSS custom property;
      if --color-surface changes in tokens.css, change it here too.
    */}
    <meta name="theme-color" content="#FAF8F5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {/*
      "summary", not "summary_large_image".

      A large-image card with no og:image renders WORSE than declaring
      nothing: the consumer reserves a hero slot and then fills it with a
      blank or a cropped favicon. WhatsApp — this agency's own secondary
      conversion channel, and the single most likely place a link to this
      site gets pasted — reads og:image directly, so a missing image is
      visible to exactly the audience that matters most.

      No image is shipped because there is no honest one to ship yet.
      Brief §79 Reminders 01/02 leave the official brand assets and
      photography outstanding, §55 forbids presenting placeholder people
      as DirectHired staff or helpers, and no image tooling is available
      here without adding a dependency. A "summary" card is correct and
      complete with title + description alone, which this page has.

      When DirectHired supplies the approved asset, this becomes a
      three-line change: restore summary_large_image, add og:image /
      og:image:width / og:image:height / twitter:image. It is tracked as a
      declared item in docs/INFORMATION-REQUIRED-BEFORE-PRODUCTION.md.
    */}
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <MobileCtaBar />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -3rem;
    left: var(--space-4);
    z-index: 100;
    padding: var(--space-3) var(--space-6);
    background: var(--color-accent);
    color: var(--color-surface);
    border-radius: var(--radius-md);
    font-family: var(--font-text);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition: top var(--duration-fast) var(--ease);
  }

  .skip-link:focus {
    top: var(--space-4);
  }
</style>
