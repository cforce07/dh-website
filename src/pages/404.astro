---
/**
 * 404 — the page a visitor gets instead of the one they asked for.
 *
 * WHY THIS EXISTS AT ALL, AND WHY IT IS NOT ONLY AN ASTRO FILE. The bucket
 * is private and served through Origin Access Control, so CloudFront asks S3
 * for the object key literally and infra/cloudfront-directory-index.js
 * rewrites /whatever to /whatever/index.html. When that key does not exist,
 * OAC answers 403 — not 404 — so until now a mistyped URL returned a bare
 * XML AccessDenied document with no header, no footer and no way back.
 * Building this file is half the fix; the other half is the
 * CustomErrorResponse that maps 403 (and 404) to /404.html with a 404
 * status, which ships as scripts/deploy-cloudfront-error-pages.sh and is run
 * by hand against the distribution.
 *
 * SHORT ON PURPOSE. What happened, and the way back. There is deliberately
 * no apology paragraph (nobody is owed one for a typo, and a page that
 * grovels reads worse than one that helps), no search box (this site has no
 * search, and building one for the error page would be the only search on
 * it), and no dump of every route — the footer below already lists all of
 * them, so a second full list on the same screen is noise.
 *
 * FIVE LINKS, NOT SEVEN. Home, Find Your Helper, Pricing, FAQ, Contact —
 * the pages somebody arrives at a broken URL looking for. /about and
 * /why-directhired are reading pages rather than destinations, and both are
 * one click away in the footer of this very page. A shortlist that is
 * shorter than the footer's list is the only reason to print a shortlist.
 *
 * NOT INDEXED, AND NO CANONICAL. A 404 is served with a 404 status once the
 * CustomErrorResponse is in place, which is enough on its own — but the file
 * is ALSO reachable directly at /404.html, where it would answer 200 and be
 * a perfectly indexable thin page. `noindex` closes that, and it is the one
 * page on this site that carries it.
 *
 * The same flag drops the self-canonical, because the two are one fact. This
 * page is served in place of EVERY URL that does not exist, so it has no URL
 * of its own to be canonical at — and the one BaseLayout would have written,
 * https://www.directhired.com/404/, is itself a URL that returns 404 once
 * the error mapping is applied. See BaseLayout's `noindex` prop.
 *
 * ONE SECTION, NO FinalCta. Registered in tests/section-rhythm.test.ts,
 * which asserts the absence rather than trusting it — see NOT_FOUND_BLOCKS
 * for the argument. Both site CTAs still reach the visitor through the
 * footer and the mobile bar, which is what satisfies the per-page CTA
 * assertions in tests/pages.test.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Container from '../components/Container.astro'

/*
 * The five routes above, as data, so the markup below is a loop rather than
 * five hand-written anchors that can drift apart in styling. Not read from
 * src/lib/nav.ts: this is a shortlist chosen for this page, and deriving it
 * from navItems would silently grow it every time the header grows — which
 * is exactly the "dump every route" outcome this page declines.
 */
const ways = [
  { label: 'Home', href: '/' },
  { label: 'Find Your Helper', href: '/find-your-helper' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Contact', href: '/contact' },
]

const title = 'Page not found — DirectHired'
const description =
  'The address you followed does not match a page on the DirectHired site. ' +
  'Here are the pages that do exist.'
---

<BaseLayout title={title} description={description} noindex>
  <section class="notfound">
    <Container>
      <h1>That page isn’t here.</h1>

      <p class="notfound-lede">
        The address you followed doesn’t match a page on this site. It may have been mistyped, or
        it may never have existed.
      </p>

      {/*
        An eyebrow rather than an <h2>: it labels a list of five links, not
        a section of the page, and it names the <nav> for a screen reader
        through aria-labelledby so the landmark is not left unlabelled.
      */}
      <p class="notfound-label" id="notfound-ways">Go to</p>
      <nav class="ways" aria-labelledby="notfound-ways">
        <ul>
          {
            ways.map((way) => (
              <li>
                <a href={way.href}>{way.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </Container>
  </section>
</BaseLayout>

<style>
  .notfound {
    /*
     * --space-12 top like every other page's opening block, but
     * --space-section-lg below rather than --space-section: this is the only
     * block on the page, so the footer would otherwise sit directly under
     * five short links on a viewport with room to spare. The larger step is
     * the one FinalCta uses, spent here on space instead of on a section.
     */
    padding-block: var(--space-12) var(--space-section-lg);
    /* The site page ground, like every other page's opening block. A 404 is
       the site minus the page that was asked for, not a different kind of
       surface. Registered in tests/section-rhythm.test.ts. */
    background: var(--color-surface);
  }

  .notfound h1 {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: var(--size-h1);
    font-weight: var(--font-weight-medium);
    line-height: 1.1;
    color: var(--color-ink);
  }

  .notfound-lede {
    max-width: 46ch;
    margin: var(--space-6) 0 0;
    font-family: var(--font-text);
    font-size: var(--size-lede);
    line-height: 1.5;
    color: var(--color-ink);
  }

  /* The site's established eyebrow treatment (TrustBadge's .trust-label,
     /about's .record dt, /contact's .office-label). --tracking-wide's
     contract requires text-transform: uppercase in the same rule —
     tests/tokens.test.ts asserts it, and it scans src/pages. */
  .notfound-label {
    margin: var(--space-12) 0 0;
    font-family: var(--font-text);
    font-size: var(--size-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .ways ul {
    display: flex;
    flex-wrap: wrap;
    /* Row gap as well as column gap: at 320 these wrap to three lines, and
       a bare `gap` shorthand with one value is what keeps the wrapped rows
       from touching. */
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-4);
  }

  /* --color-accent (6.03:1 on cream), never --color-brand-teal, which
     measures 2.89:1 and carries no text anywhere on this site. */
  .ways a {
    display: inline-block;
    font-family: var(--font-text);
    font-size: var(--size-h3);
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }

  .ways a:hover {
    color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }
</style>
