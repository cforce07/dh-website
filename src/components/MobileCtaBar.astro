---
/**
 * MobileCtaBar — fixed bottom bar, visible only below --bp-desktop
 * (64em, tokens.css) — the same breakpoint Header.astro and
 * MobileNav.astro switch on; the max-width query below must keep using
 * the literal in sync with theirs. Carries both CTAs, primary given
 * visual weight via flex-grow.
 *
 * It must never occlude content: `--mobile-bar-height` is the single
 * source both this bar's min-height and the global `body` bottom padding
 * are derived from, so the two can't drift apart. The bar's own bottom
 * padding additionally reserves `env(safe-area-inset-bottom)` for
 * home-indicator devices, and the body padding adds the same safe-area
 * term — so on a device with a safe-area inset, body padding is always
 * at least as large as the bar's actual rendered height (verified by
 * construction: floor height 4.75rem vs. actual content+padding of
 * roughly 4.5rem, a deliberate buffer).
 */
import Button from './Button.astro'
import { company } from '../data/company'
import { defaultWhatsappUrl } from '../lib/whatsapp'

const whatsappHref = defaultWhatsappUrl()
---

<div class="mobile-cta-bar">
  <Button variant="primary" href={company.requirementFormUrl}>Submit Your Requirements</Button>
  <Button variant="secondary" href={whatsappHref} external>WhatsApp Us</Button>
</div>

<style>
  :global(:root) {
    --mobile-bar-height: 4.75rem;
  }

  .mobile-cta-bar {
    display: none;
  }

  .mobile-cta-bar :global(.btn) {
    flex: 1;
  }

  .mobile-cta-bar :global(.primary) {
    flex: 1.4;
  }

  /* 63.99em, one hair below --bp-desktop (64em), so this query and
     Header/MobileNav's `min-width: 64em` never both match at once.
     Must match Header.astro and MobileNav.astro exactly. */
  @media (max-width: 63.99em) {
    :global(body) {
      padding-bottom: calc(var(--mobile-bar-height) + env(safe-area-inset-bottom));
    }

    .mobile-cta-bar {
      display: flex;
      align-items: stretch;
      gap: var(--space-3);
      position: fixed;
      inset-inline: 0;
      inset-block-end: 0;
      z-index: 40;
      min-height: var(--mobile-bar-height);
      padding: var(--space-3) var(--space-4);
      padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
      background: var(--color-surface-raised);
      border-top: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
    }
  }
</style>
