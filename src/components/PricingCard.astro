---
/**
 * PricingCard — renders a single Package. Branches on `pkg.kind`, and that
 * branch is what makes the §4.2 constraint a compiler guarantee rather than
 * a matter of care: `TotalOnlyPackage` has no `lineItems` property at all
 * (see src/data/pricing.ts), so the discriminated union only narrows `pkg`
 * to a type carrying `lineItems` inside the `pkg.kind === 'itemised'`
 * branch below. Reaching for `pkg.lineItems` anywhere else — the
 * total-only path, or outside this conditional entirely — is a type
 * error, not a runtime mistake someone could ship by accident.
 *
 * As of 2026-08-16 BOTH packages are itemised — DirectHired supplied the
 * without-replacement breakdown — so the total-only branch currently has
 * no instance. It is kept, not deleted: it is the thing that makes an
 * invented itemisation a type error, and the next package that arrives
 * with an unknown breakdown must reach for it rather than guessing. A
 * total-only package would render its total alone, with no line items and
 * nothing invented to fill the space.
 *
 * The one non-branching value, the total itself, always comes from
 * packageTotalCents() + formatSgd() — never a literal string.
 */
import type { Package } from '../data/pricing'
import { packageTotalCents } from '../data/pricing'
import { formatSgd } from '../lib/money'
import Card from './Card.astro'

interface Props {
  pkg: Package
}

const { pkg } = Astro.props
const total = packageTotalCents(pkg)
---

<Card>
  <div class:list={['pricing-card', pkg.kind]}>
    <h3 class="pkg-name">{pkg.name}</h3>

    {
      pkg.kind === 'itemised' && (
        <ul class="line-items">
          {pkg.lineItems.map((item) => (
            <li>
              <span class="item-label">{item.label}</span>
              <span class="item-amount">{formatSgd(item.amountCents)}</span>
            </li>
          ))}
        </ul>
      )
    }

    <div class="pkg-total">
      <span class="total-label">Total</span>
      <span class="total-amount">{formatSgd(total)}</span>
    </div>

    {pkg.replacementTerm && <p class="pkg-replacement">{pkg.replacementTerm}</p>}
  </div>
</Card>

<style>
  .pricing-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .pkg-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
  }

  .line-items {
    display: flex;
    flex-direction: column;
  }

  .line-items li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-text);
    font-size: var(--size-body);
  }

  .line-items li:first-child {
    padding-top: 0;
  }

  .line-items li:last-child {
    border-bottom: none;
  }

  .item-label {
    color: var(--color-ink-muted);
  }

  .item-amount {
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .pkg-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1.5px solid var(--color-border);
  }

  .total-label {
    font-family: var(--font-text);
    font-size: var(--size-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .total-amount {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  /* Unused while both packages are itemised, and deliberately retained
     alongside the total-only branch in the markup above: a total-only
     card would have nothing else on it, so its number carries more
     visual weight to stop the card reading as sparse. */
  .total-only .total-amount {
    font-size: 2.25rem;
  }

  .pkg-replacement {
    font-family: var(--font-text);
    font-size: var(--size-small);
    color: var(--color-ink-muted);
  }
</style>
