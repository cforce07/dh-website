---
/**
 * MobileNav — the only JavaScript in the header. A toggle button opens a
 * full-screen panel listing `navItems`, then both CTAs at full width with
 * the primary ("Submit Your Requirements") first.
 *
 * Accessibility (binding, not aspirational):
 * - Toggle carries `aria-expanded`, kept in sync with panel state.
 * - While open, focus is trapped inside the panel (Tab/Shift+Tab wrap).
 * - Escape closes the panel and returns focus to the toggle button.
 * - The panel is hidden via the `hidden` attribute (not just opacity),
 *   so it is removed from the accessibility tree and tab order when
 *   closed — no CSS-only illusion of hiding.
 *
 * Visible only below --bp-desktop (64em, tokens.css) — the same
 * breakpoint Header.astro and MobileCtaBar.astro switch on. Must stay
 * in sync with both (CSS custom properties don't resolve inside @media
 * conditions, so each file repeats the literal value in a comment).
 *
 * While open, the script adds `mobile-nav-open` to `<body>`, which locks
 * body scroll (see the `:global(body.mobile-nav-open)` rule below). This
 * matters most on iOS: rubber-band overscroll can reveal page content
 * behind even a `position: fixed; inset: 0` panel without an explicit
 * scroll lock.
 */
import Button from './Button.astro'
import { navItems } from '../lib/nav'
import { company } from '../data/company'
import { defaultWhatsappUrl } from '../lib/whatsapp'

const whatsappHref = defaultWhatsappUrl()
---

<div class="mobile-nav">
  <button
    type="button"
    class="mobile-nav-toggle"
    aria-expanded="false"
    aria-controls="mobile-nav-panel"
    data-mobile-nav-toggle
  >
    <span class="toggle-bar" aria-hidden="true"></span>
    <span class="toggle-bar" aria-hidden="true"></span>
    <span class="toggle-bar" aria-hidden="true"></span>
    <span class="sr-only">Menu</span>
  </button>

  <div id="mobile-nav-panel" class="mobile-nav-panel" data-mobile-nav-panel hidden>
    <div class="panel-header">
      <span class="panel-brand">{company.name}</span>
      <button type="button" class="panel-close" data-mobile-nav-close>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span class="sr-only">Close menu</span>
      </button>
    </div>

    <nav class="panel-nav" aria-label="Primary">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="panel-ctas">
      <Button variant="primary" href={company.requirementFormUrl}>Submit Your Requirements</Button>
      <Button variant="secondary" href={whatsappHref} external>WhatsApp Us</Button>
    </div>
  </div>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-nav-toggle]')
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav-panel]')
  const closeButton = document.querySelector<HTMLButtonElement>('[data-mobile-nav-close]')

  if (toggle && panel && closeButton) {
    let lastFocused: HTMLElement | null = null

    const focusableSelector = 'a[href], button:not([disabled])'

    function getFocusable(): HTMLElement[] {
      return Array.from(panel!.querySelectorAll<HTMLElement>(focusableSelector))
    }

    function onKeydown(event: KeyboardEvent): void {
      if (event.key === 'Escape') {
        event.preventDefault()
        closeMenu()
        return
      }

      if (event.key === 'Tab') {
        const focusable = getFocusable()
        if (focusable.length === 0) return

        const first = focusable[0]
        const last = focusable[focusable.length - 1]

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault()
          last.focus()
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault()
          first.focus()
        }
      }
    }

    function openMenu(): void {
      lastFocused = document.activeElement as HTMLElement | null
      toggle!.setAttribute('aria-expanded', 'true')
      panel!.hidden = false
      document.body.classList.add('mobile-nav-open')
      document.addEventListener('keydown', onKeydown)
      const focusable = getFocusable()
      ;(focusable[0] ?? closeButton!).focus()
    }

    function closeMenu(): void {
      toggle!.setAttribute('aria-expanded', 'false')
      panel!.hidden = true
      document.body.classList.remove('mobile-nav-open')
      document.removeEventListener('keydown', onKeydown)
      ;(lastFocused ?? toggle!).focus()
    }

    toggle.addEventListener('click', () => {
      const isOpen = toggle!.getAttribute('aria-expanded') === 'true'
      if (isOpen) {
        closeMenu()
      } else {
        openMenu()
      }
    })

    closeButton.addEventListener('click', closeMenu)
  }
</script>

<style>
  .mobile-nav {
    display: block;
  }

  .mobile-nav-toggle {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-ink-muted);
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .toggle-bar {
    display: block;
    width: 1.25rem;
    height: 2px;
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    transition: transform var(--duration-fast) var(--ease), opacity var(--duration-fast) var(--ease);
  }

  .mobile-nav-toggle[aria-expanded='true'] .toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-nav-toggle[aria-expanded='true'] .toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-nav-toggle[aria-expanded='true'] .toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .mobile-nav-panel {
    position: fixed;
    inset: 0;
    z-index: 50;
    flex-direction: column;
    background: var(--color-surface);
    overflow-y: auto;
    padding: var(--space-6);
  }

  /*
   * `display` is scoped to `:not([hidden])` deliberately. An unconditional
   * `display: flex` here is author CSS and, per cascade rules, overrides
   * the UA stylesheet's `[hidden] { display: none }` at equal specificity
   * — which would make the panel render open by default the moment its
   * flex-column ancestor (.mobile-nav) stops being display:none (i.e. at
   * any viewport below the desktop breakpoint), regardless of the toggle.
   * Confirmed by manual testing: with the unscoped rule, the panel was
   * visible on load without any click.
   */
  .mobile-nav-panel:not([hidden]) {
    display: flex;
  }

  /*
   * Scroll lock while the panel is open. Simple `overflow: hidden` on
   * body — proportionate for a marketing site's mobile nav, not an app
   * shell. Without this, iOS Safari's rubber-band overscroll can reveal
   * page content behind the fixed-position panel even though the panel
   * itself covers the full viewport.
   */
  :global(body.mobile-nav-open) {
    overflow: hidden;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-8);
  }

  .panel-brand {
    font-family: var(--font-display);
    font-size: var(--size-h3);
    color: var(--color-ink);
  }

  .panel-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: transparent;
    border: 1px solid var(--color-ink-muted);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    cursor: pointer;
  }

  .panel-nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .panel-nav a {
    font-family: var(--font-display);
    font-size: var(--size-h3);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
    text-decoration: none;
  }

  .panel-nav a:hover {
    color: var(--color-accent);
  }

  .panel-ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
  }

  .panel-ctas :global(.btn) {
    width: 100%;
  }

  /* Must match --bp-desktop (tokens.css), and the literal in
     Header.astro / MobileCtaBar.astro. */
  @media (min-width: 64em) {
    .mobile-nav {
      display: none;
    }
  }
</style>
