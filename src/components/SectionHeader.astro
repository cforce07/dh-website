---
/**
 * SectionHeader — the recurring "title / lede" block that opens most
 * homepage sections. `lede` is optional so a section can ship a bare
 * title where that's all it needs.
 *
 * This primitive used to carry an optional `eyebrow` (a small teal-rule
 * label above the title) with zero call sites anywhere on the site —
 * dead code that would also have spent the brand's one connective
 * gesture (the teal rule) on routine section furniture before block 07's
 * crossbar ever got to mean anything. Deleted; see
 * docs/design/implementation-plan-2026-08-16.md C-31 / D-11. The teal
 * rule is reserved for exactly two places: block 07's crossbar and
 * FinalCta's `.cta-mark`.
 */
interface Props {
  title: string
  lede?: string
}

const { title, lede } = Astro.props
---

<div class="section-header">
  <h2 class="title">{title}</h2>
  {lede && <p class="lede">{lede}</p>}
</div>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--size-h2);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
  }

  .lede {
    max-width: 60ch;
    margin-top: var(--space-4);
    font-family: var(--font-text);
    font-size: var(--size-lede);
    font-weight: var(--font-weight-regular);
    line-height: 1.5;
    color: var(--color-ink-muted);
  }
</style>
