---
/**
 * Header — wordmark left, primary nav centre, primary CTA right. Above
 * the desktop breakpoint (75em / 1200px — see --bp-desktop in tokens.css
 * for the measurement behind that value) this is the only nav surface;
 * below it, the centre nav and CTA are hidden in favour of <MobileNav>,
 * which renders its own toggle button here and a full-screen panel.
 *
 * The header carries ONE CTA, the primary. That is not a hierarchy
 * violation: the conversion rule (spec §6.4) orders the pair on surfaces
 * that carry BOTH — it does not require every surface to carry both.
 * "WhatsApp Us" is still permanently on screen below the breakpoint (the
 * fixed <MobileCtaBar>), and above it, in the mobile nav panel, the
 * hero, pricing, the final CTA and the footer. The header's job here is
 * to fit in one line beside seven nav labels; see the width writeup on
 * --bp-desktop. The primary href comes from `company.requirementFormUrl`
 * only — never hardcode it, tests/links.test.ts asserts that.
 *
 * The wordmark is DirectHired's real mark (src/assets/logo-wordmark.svg),
 * inlined by Astro so it costs no request in the LCP path. It is
 * aria-hidden; the <a> owns the accessible name.
 */
import Container from './Container.astro'
import Button from './Button.astro'
import MobileNav from './MobileNav.astro'
import Wordmark from '../assets/logo-wordmark.svg'
import { navItems } from '../lib/nav'
import { company } from '../data/company'
---

<header class="site-header">
  <Container>
    <div class="header-inner">
      <a class="logo" href="/" aria-label={`${company.name} home`}>
        <Wordmark class="logo-wordmark" aria-hidden="true" />
      </a>

      <nav class="primary-nav" aria-label="Primary">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-ctas">
        <Button variant="primary" href={company.requirementFormUrl}>Submit Your Requirements</Button>
      </div>

      <MobileNav />
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* --space-4, not --space-6. Retained after the width-compaction fix
       was otherwise unwound (see the note where the CTA padding override
       used to be): 16px is the right optical separation between a
       wordmark and a nav rail, and the 16px it saves is 16px of margin
       against --bp-desktop. */
    gap: var(--space-4);
    min-height: 4.5rem;
  }

  /*
   * flex: 0 0 auto on all three children, and this is load-bearing, not
   * tidiness. With the default flex-shrink: 1 the flex line always "fits"
   * by squeezing its items, so .header-inner.scrollWidth never exceeds
   * its clientWidth — the overflow metric reads clean at every width and
   * the header looks fine to every automated check. What actually
   * happened when measured: at a 1040px viewport the .logo BOX shrank
   * from 178px to 117px while the <svg> inside it, sized off its own
   * viewBox ratio, kept painting to 178px — the wordmark rendered
   * straight through the first nav item, with scrollWidth == clientWidth
   * the whole time.
   *
   * Refusing to shrink converts that silent overlap into real overflow,
   * which document.scrollWidth and tests/header-fit.test.ts can both
   * see. A header that does not fit should fail loudly.
   */
  .logo,
  .primary-nav,
  .header-ctas {
    flex: 0 0 auto;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    /* No font-family/size/colour: the wordmark is artwork now, not type.
       It replaced a Fraunces (serif) re-typesetting of "DirectHired"
       beside a plain teal square — the real mark is a geometric sans and
       the square was not derived from it. */
    text-decoration: none;
  }

  /*
   * 26px, not the 24px cap-equivalent of the old --size-h3 typesetting.
   * The asset's viewBox (849 × 124) is a tight crop whose height runs
   * from the top of the H's two dots to the wordmark baseline, so cap
   * height is only ~0.747 of the rendered height — matching the old mark
   * on cap height alone would have shrunk its optical presence. 26px
   * renders 178px wide; every px here is spent against the header width
   * budget on --bp-desktop, so re-measure if you change it.
   *
   * `display: block` kills the inline-baseline gap under the svg;
   * `width: auto` lets the intrinsic viewBox ratio drive width so the
   * mark can never be stretched.
   */
  .logo :global(.logo-wordmark) {
    display: block;
    height: 26px;
    width: auto;
  }

  .primary-nav {
    display: none;
  }

  .primary-nav ul {
    display: flex;
    align-items: center;
    /* --space-3, not --space-6: 6 gaps across 7 items adds up fast, and
       12px still reads as separate items at --size-body. */
    gap: var(--space-3);
  }

  .primary-nav a {
    font-family: var(--font-text);
    font-size: var(--size-body);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease);
  }

  .primary-nav a:hover {
    color: var(--color-accent);
  }

  .header-ctas {
    display: none;
    align-items: center;
    gap: var(--space-3);
  }

  /*
   * There is deliberately NO padding-inline override on the header CTA.
   * One used to sit here, compacting Button.astro's --space-6 (24px/side)
   * down to --space-4 purely so a header carrying 8 nav labels and 2
   * buttons could fit. Dropping "Home", shortening "Why DirectHired" to
   * "Why Us" and removing the secondary CTA freed enough width that the
   * header now fits at its normal padding, so the header's button
   * matches every other button on the site again. Do not re-add a
   * compaction override — if the header stops fitting, the honest fix is
   * fewer things in it or a wider --bp-desktop.
   */

  /* 75em matches --bp-desktop in tokens.css (kept in sync by hand — see
     that token's long comment for the measurement behind this specific
     value; it is not a round guess). Below this, MobileNav owns
     navigation. Must match MobileNav.astro and MobileCtaBar.astro
     exactly, or a viewport range opens where neither nav surface is
     present. tests/header-fit.test.ts asserts all four stay in sync. */
  @media (min-width: 75em) {
    .primary-nav {
      display: block;
    }

    .header-ctas {
      display: flex;
    }
  }
</style>
