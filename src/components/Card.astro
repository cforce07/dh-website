---
/**
 * Card — the generic raised-surface container used for feature tiles,
 * job listings, testimonials, etc. across the homepage sections.
 *
 * --color-surface-raised is only a few shades off --color-surface, so a
 * hairline border alone would read flat. --shadow-sm gives it the "lifted
 * paper" separation the spec asks for; the border is a secondary cue,
 * not the only one, so the decorative --color-border hairline is the
 * correct token here (see the contrast note in tokens.css).
 */
---

<div class="card"><slot /></div>

<style>
  .card {
    /* Grid/flex items default to `min-width: auto`, which floors their
       size at their content's min-content width — inside a single-column
       `.pricing-grid` below 48em that stops the card from shrinking to
       fit the track, causing horizontal overflow (measured at 320px:
       card renders 285px wide against 257px available). `min-width: 0`
       only changes behaviour when Card is a grid/flex item; it's a no-op
       everywhere else, so it's safe to set unconditionally here rather
       than only in pricing-grid's stylesheet. */
    min-width: 0;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow var(--duration-base) var(--ease),
      transform var(--duration-base) var(--ease);
  }

  .card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
</style>
