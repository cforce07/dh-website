---
/**
 * Button — renders as an anchor, never a <button>, because every CTA on
 * this site navigates somewhere (a form, WhatsApp, an anchor link). The
 * site's conversion hierarchy is fixed: `primary` is always "Submit Your
 * Requirements", `secondary` is always "WhatsApp Us". `ghost` is for
 * tertiary, in-copy actions (e.g. "Learn more").
 *
 * `external` adds target="_blank" + rel="noopener noreferrer" — required
 * for the WhatsApp deep link.
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost'
  href: string
  external?: boolean
}

const { variant = 'primary', href, external = false } = Astro.props
const rel = external ? 'noopener noreferrer' : undefined
const target = external ? '_blank' : undefined
---

<a class:list={['btn', variant]} href={href} rel={rel} target={target}>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    /*
     * 44px, the minimum comfortable touch target. Every button on the site
     * rendered at 40–41px (12px padding either side of a 16px label at
     * line-height 1), including the two in the fixed mobile bar, which is
     * where it matters most and where a mis-tap costs a conversion.
     *
     * A min-height rather than more padding: padding would have widened
     * nothing but would have changed the compact override in
     * MobileCtaBar.astro and the header's fit arithmetic (--bp-desktop was
     * measured against this button's current padding — see tokens.css).
     * The floor only ever adds height, and `align-items: center` above
     * keeps the label centred in it.
     *
     * MobileCtaBar's --mobile-bar-height was re-measured against this; see
     * the note there.
     */
    min-block-size: 2.75rem;
    border-radius: var(--radius-md);
    font-family: var(--font-text);
    font-size: var(--size-body);
    font-weight: var(--font-weight-semibold);
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease),
      box-shadow var(--duration-fast) var(--ease),
      transform var(--duration-fast) var(--ease);
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Primary — "Submit Your Requirements". The one loud thing per view. */
  .primary {
    background: var(--color-accent);
    color: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .primary:hover {
    background: var(--color-accent-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .primary:active {
    transform: translateY(0);
    box-shadow: var(--shadow-sm);
  }

  /*
   * Secondary — "WhatsApp Us". An outline button whose border is the
   * only thing separating it from the page, so per the token comment in
   * tokens.css it uses --color-ink-muted (7.97:1) rather than the
   * decorative --color-border hairline (~1.3:1), which would fail the
   * 3:1 non-text contrast threshold here.
   */
  .secondary {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-ink-muted);
  }

  .secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .secondary:active {
    transform: translateY(0);
  }

  /* Ghost — tertiary, in-copy actions. Text only, no lift. */
  .ghost {
    background: transparent;
    color: var(--color-ink);
    padding-inline: 0;
    border-bottom: 1px solid var(--color-ink-muted);
    border-radius: 0;
  }

  .ghost:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
